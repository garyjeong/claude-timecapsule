def resolve_project(name):
    """MCP 는 작업 폴더가 없다 — 경로가 아닌 이름(viewster)은 색인에 있는 프로젝트 경로 중 폴더 이름이 같은 것으로 바꾼다."""
    if not name or name.startswith(("/", "~")):
        return name
    con = connect()
    rows = con.execute("SELECT project, COUNT(*) FROM entries WHERE project IS NOT NULL AND substr(project, 1, 1) = '/'"
                       " AND (project = ? OR substr(project, -?) = ?) GROUP BY project ORDER BY 2 DESC",
                       (name, len(name) + 1, "/" + name)).fetchall()
    return rows[0][0] if rows else name


def mcp_argv(name, a):
    def num(k, default):
        try:
            return str(int(a.get(k) or default))
        except (TypeError, ValueError):
            return str(default)
    if name == "timecapsule_search":
        argv = ["search", "--limit", num("limit", 20)]
        if a.get("project"):
            argv += ["--project", resolve_project(str(a["project"]))]
        for k in ("agent", "role", "sort"):
            if a.get(k):
                argv += ["--" + k, str(a[k])]
        if a.get("days"):
            argv += ["--days", num("days", 0)]
        return argv + ["--", str(a.get("query") or "")]
    if name == "timecapsule_recent":
        argv = ["recent", "--limit", num("limit", 8), "--max-chars", "8000"]
        argv += ["--project", resolve_project(str(a["project"]))] if a.get("project") else ["--all"]
        if a.get("days"):
            argv += ["--days", num("days", 0)]
        if a.get("include_auto"):
            argv.append("--include-auto")
        return argv
    if name == "timecapsule_session":
        argv = ["session", "--offset", num("offset", 0), "--limit", num("limit", 150)]
        if a.get("role"):
            argv += ["--role", str(a["role"])]
        return argv + ["--", str(a.get("id") or "")]
    if name == "timecapsule_touched":
        argv = ["touched", "--limit", num("limit", 10)]
        if a.get("days"):
            argv += ["--days", num("days", 0)]
        return argv + ["--", str(a.get("path") or "")]
    if name == "timecapsule_lessons":
        argv = ["lessons", "--limit", num("limit", 30), "--days", num("days", 30)]
        argv += ["--project", resolve_project(str(a["project"]))] if a.get("project") else ["--all"]
        return argv
    if name == "timecapsule_stats":
        return ["stats"]
    raise KeyError(name)


def mcp_call(params):
    name = params.get("name")
    a = params.get("arguments") or {}

    def result(text, err=False):
        return {"content": [{"type": "text", "text": text}], "isError": err}
    try:
        argv = mcp_argv(name, a)
    except KeyError:
        return result(f"알 수 없는 도구: {name}", True)
    out, err = io.StringIO(), io.StringIO()
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            ns = build_parser().parse_args(argv)
            ns.fn(ns)
    except SystemExit:
        return result(err.getvalue().strip() or "인자 오류", True)
    except Exception as e:
        return result(f"{e.__class__.__name__}: {e}", True)
    return result(out.getvalue() or "(출력 없음)")


def cmd_mcp(args):
    """MCP stdio 서버 — 줄 단위 JSON-RPC. stdout 은 프로토콜 전용이라 도구 출력은 모두 가로채서 돌려준다."""
    stdin = io.TextIOWrapper(sys.stdin.buffer, encoding="utf-8", errors="replace")
    real_out = sys.stdout

    def send(msg):
        real_out.write(json.dumps(msg) + "\n")  # ensure_ascii — 로캘이 없는 환경에서도 깨지지 않게
        real_out.flush()
    while True:
        raw = stdin.readline()
        if not raw:
            break
        raw = raw.strip()
        if not raw:
            continue
        try:
            req = json.loads(raw)
        except Exception:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}})
            continue
        if not isinstance(req, dict) or req.get("id") is None:
            continue  # 알림(notifications/*)은 답하지 않는다
        mid, method, params = req.get("id"), req.get("method"), req.get("params") or {}
        try:
            if method == "initialize":
                res = {"protocolVersion": params.get("protocolVersion") or "2025-06-18",
                       "capabilities": {"tools": {"listChanged": False}},
                       "serverInfo": {"name": "timecapsule", "version": VERSION},
                       "instructions": MCP_INSTRUCTIONS}
            elif method == "ping":
                res = {}
            elif method == "tools/list":
                res = {"tools": MCP_TOOLS}
            elif method == "tools/call":
                res = mcp_call(params)
            else:
                send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"method not found: {method}"}})
                continue
            send({"jsonrpc": "2.0", "id": mid, "result": res})
        except Exception as e:
            send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32603, "message": f"{e.__class__.__name__}: {e}"}})


# ---------------------------------------------------------------- main
def build_parser():
    p = argparse.ArgumentParser(prog="timecapsule", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("index", help="증분 색인")
    a.add_argument("--quick", action="store_true", help="4초 예산 안에서 최신 파일부터")
    a.add_argument("--timeout", type=float, help="초 단위 예산")
    a.add_argument("--quiet", action="store_true")
    a.set_defaults(fn=cmd_index)

    a = sub.add_parser("recent", help="최근 세션 요약")
    a.add_argument("--project", default=os.getcwd())
    a.add_argument("--all", action="store_true", help="프로젝트 필터 없이")
    a.add_argument("--limit", type=int, default=5)
    a.add_argument("--days", type=int)
    a.add_argument("--max-chars", type=int, default=3000)
    a.add_argument("--include-auto", action="store_true", help="codex exec·claude -p 같은 자동 실행 세션도")
    a.add_argument("--include-current", action="store_true", help="지금 세션(CLAUDE_CODE_SESSION_ID)도")
    a.add_argument("--exclude-session", help="이 세션 id 는 뺀다")
    a.add_argument("--no-index", action="store_true", help="조회 전 짧은 색인을 건너뛴다")
    a.add_argument("--json", action="store_true")
    a.set_defaults(fn=cmd_recent)

    a = sub.add_parser("search", help="전문 검색")
    a.add_argument("query")
    a.add_argument("--project")
    a.add_argument("--agent", choices=["claude", "codex", "cowork", "claude-mem", "markdown"])
    a.add_argument("--role", choices=["user", "assistant", "tool", "observation", "summary", "note"])
    a.add_argument("--days", type=int)
    a.add_argument("--limit", type=int, default=20)
    a.add_argument("--sort", choices=["recent", "rank"], default="recent", help="rank=관련도(bm25)순")
    a.add_argument("--per-session", type=int, default=3, help="세션당 최대 결과 수 (0=제한 없음)")
    a.add_argument("--include-current", action="store_true", help="지금 세션도")
    a.add_argument("--exclude-session")
    a.add_argument("--no-index", action="store_true")
    a.add_argument("--json", action="store_true")
    a.add_argument("--src", action="store_true", help="원본 파일:줄 표시")
    a.set_defaults(fn=cmd_search)

    a = sub.add_parser("session", help="세션 타임라인")
    a.add_argument("id")
    a.add_argument("--width", type=int, default=300)
    a.add_argument("--offset", type=int, default=0)
    a.add_argument("--limit", type=int, default=0, help="0=전부")
    a.add_argument("--role", choices=["user", "assistant", "tool", "observation", "summary", "note"])
    a.add_argument("--src", action="store_true")
    a.set_defaults(fn=cmd_session)

    a = sub.add_parser("tools", help="도구 호출 집계")
    a.add_argument("--session")
    a.add_argument("--project", default=os.getcwd())
    a.add_argument("--days", type=int)
    a.add_argument("--limit", type=int, default=20)
    a.add_argument("--commands", action="store_true", help="셸 명령 앞 두 토큰 집계도")
    a.set_defaults(fn=cmd_tools)

    a = sub.add_parser("touched", help="이 파일·폴더를 다룬 세션")
    a.add_argument("path")
    a.add_argument("--days", type=int)
    a.add_argument("--limit", type=int, default=10, help="세션 수")
    a.add_argument("--json", action="store_true")
    a.set_defaults(fn=cmd_touched)

    a = sub.add_parser("lessons", help="사용자 교정·규칙 발화 후보 (검토용)")
    a.add_argument("--project", default=os.getcwd())
    a.add_argument("--all", action="store_true", help="프로젝트 필터 없이")
    a.add_argument("--days", type=int, default=30, help="0=전체 기간")
    a.add_argument("--limit", type=int, default=30)
    a.add_argument("--json", action="store_true")
    a.set_defaults(fn=cmd_lessons)

    a = sub.add_parser("forget", help="한 세션을 색인에서 지운다")
    a.add_argument("id")
    a.add_argument("--yes", action="store_true")
    a.set_defaults(fn=cmd_forget)

    a = sub.add_parser("rebuild", help="원본이 남은 파일을 다시 색인")
    a.add_argument("--yes", action="store_true")
    a.add_argument("--no-backup", action="store_true")
    a.set_defaults(fn=cmd_rebuild)

    a = sub.add_parser("stats", help="통계")
    a.set_defaults(fn=cmd_stats)

    a = sub.add_parser("migrate-claude-mem", help="claude-mem 관찰 이관")
    a.add_argument("--db", default="~/.claude-mem/claude-mem.db")
    a.add_argument("--force", action="store_true")
    a.set_defaults(fn=cmd_migrate_claude_mem)

    a = sub.add_parser("doctor", help="점검")
    a.set_defaults(fn=cmd_doctor)

    a = sub.add_parser("hook", help="Claude Code 훅 진입점")
    a.add_argument("event", choices=["session-start", "prompt", "stop", "codex-session-start", "codex-prompt", "codex-stop"])
    a.set_defaults(fn=cmd_hook)

    a = sub.add_parser("mcp", help="MCP stdio 서버")
    a.set_defaults(fn=cmd_mcp)
    return p


def main(argv=None):
    os.umask(0o077)  # 새로 만드는 DB·WAL·백업이 처음부터 본인만 읽을 수 있게
    args = build_parser().parse_args(argv)
    hard = None
    if args.cmd == "index":
        hard = args.timeout or (4 if args.quick else None)
    try:
        if hard:
            with alarm(hard + 2):
                args.fn(args)
        else:
            args.fn(args)
    except HardTimeout:
        debug("timeout — 끝난 파일까지 반영, 진행 중이던 파일은 다음 색인에서 다시")
    except BrokenPipeError:
        pass
    except Exception as e:
        sys.stderr.write(f"timecapsule: {e.__class__.__name__}: {e}\n")
        if os.environ.get("TIMECAPSULE_DEBUG"):
            raise
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
