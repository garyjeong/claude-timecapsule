""".split())
# ---- lessons: 교정·규칙 발화의 신호어. 짧고(400자 미만) 사람이 연 세션의 user 발화에서만 본다
# 요청 동사 어미 — 이것으로 끝나는 말은 통째로 뺀다 (넣어줘·조사해줘·바꿔주세요·알려줄래)
REQUEST_END = re.compile(r".{1,}(?:해줘|해주세요|해줄래|해봐|해보자|해라|하자|하라|해야|줘|주세요|줄래|십시오|시오|해봐요|해요)$")
LESSON_PATTERNS = ("앞으로", "다시는", "하지 마", "하지마", "했잖아", "말라고", "라고 했", "금지", "그만", "항상", "반드시", "잊지 마", "기억해")
LESSON_MAX_CHARS = 400
REDACT = [
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|\Z)", re.S), "••••private-key••••"),
    (re.compile(r"AKIA[0-9A-Z]{16}"), "AKIA••••"),
    (re.compile(r"\bAIza[0-9A-Za-z_\-]{30,}"), "AIza••••"),
    (re.compile(r"\b(?:github_pat_|glpat-|npm_)[A-Za-z0-9_\-]{20,}"), "••••token••••"),
    (re.compile(r"\b(sk|ghp|gho|ghs|ghu|ghr|xox[bpaers]|pk|rk)[-_][A-Za-z0-9_\-]{16,}"), "••••token••••"),
    (re.compile(r"(?i)bearer\s+[A-Za-z0-9\-_\.=~+/]{16,}"), "Bearer ••••"),
    (re.compile(r"eyJ[A-Za-z0-9_\-]{20,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}"), "••••jwt••••"),
    (re.compile(r"(\b[A-Za-z][A-Za-z0-9+.\-]*://[^\s:/@'\"]+:)[^\s@/'\"]+@"), r"\1••••@"),
    (re.compile(r"(?i)(authorization\s*[:=]\s*[\"']?basic)\s+[A-Za-z0-9+/=]{8,}"), r"\1 ••••"),
    (re.compile(r"(\s-u\s+[\"']?[^\s:'\"]+:)[^\s'\"]+"), r"\1••••"),  # curl -u user:pass
]
# 이름에 password·secret·token 등이 든 키 = 값. 키·값 모두 따옴표(\" 이스케이프 포함)가 있어도 된다 — JSON·셸·YAML 꼴
KV_RX = re.compile(
    r"(?i)(?P<kq>\\?[\"']?)(?P<key>[A-Za-z0-9_.\-]*(?:password|passwd|secret|token|api[_-]?key|access[_-]?key"
    r"|private[_-]?key|credential)[A-Za-z0-9_.\-]*)(?P=kq)(?P<sep>\s*[=:]\s*)"
    r"(?:(?P<vq>\\?[\"'])(?P<qv>(?:(?!(?P=vq)).){3,})(?P=vq)|(?P<bv>[^\s\"'\\,;{}()\[\]]{6,}))")
# 비밀이 아닌 키(개수·이름·경로 등)와 비밀이 아닌 값(자리표시자·타입 이름)은 살린다 — 검색에 쓰이는 설정값을 지우지 않게
# 키는 소문자로 비교한다 — SecretId·secretName 같은 camelCase 도 구분자 없이 잡히게
KV_KEEP_KEY = re.compile(r"tokens|tokenizer|token_?(?:count|type|usage|limit|budget|len|length|id|ids|index)\b"
                         r"|[_.\-]?(?:id|ids|name|arn|ref|path|file|dir|type|count|policy|manager|store|prefix|url|uri"
                         r"|rotation|version|length|len|limit|env|var|field)$")
# 변수 참조는 대문자 환경변수 꼴만 살린다 — '$ecret123x' 같은 값이 변수로 오인돼 새지 않게
KV_KEEP_VAL = re.compile(r"•.*|\$\{?[A-Z_][A-Z0-9_]*\}?|%[A-Z_][A-Z0-9_]*%|%\([a-z_]+\)s|<[^<>]+>|\{\{.*\}\}"
                         r"|\*+|[xX]+|\.\.\.|…|(?i:null|none|true|false|undefined|required|optional(?:\[.*)?|str|string|int"
                         r"|bool|bytes|secretstr|any|number|boolean)")


def _kv_sub(m):
    key = m.group("key")
    quoted = m.group("vq") is not None
    val = m.group("qv") if quoted else m.group("bv")
    if KV_KEEP_KEY.search(key.lower()) or KV_KEEP_VAL.fullmatch(val.strip()):
        return m.group(0)
    head = m.group("kq") + key + m.group("kq") + m.group("sep")
    return head + (m.group("vq") + "••••" + m.group("vq") if quoted else "••••")


def debug(msg):
    if os.environ.get("TIMECAPSULE_DEBUG"):
        sys.stderr.write(f"[timecapsule] {msg}\n")


def redact(text):
    for rx, rep in REDACT:
        text = rx.sub(rep, text)
    return KV_RX.sub(_kv_sub, text)


def clip(text, n=TEXT_CAP):
    text = text.strip()
    return text if len(text) <= n else text[:n] + " …"


def clean(text, role):
    """비밀값을 먼저 가리고 자른다 — 잘린 토큰 조각이 가림 패턴을 빠져나가지 않게."""
    return clip(redact(text), TOOL_CAP if role == "tool" else TEXT_CAP)


def load_config():
    cfg = {"extra_markdown_dirs": [], "exclude_project_dirs": list(EXCLUDE_PROJECT_DIRS)}
    try:
        with open(CONFIG_PATH) as fh:
            cfg.update(json.load(fh))
    except Exception:
        pass
    return cfg


def since(days):
    return (datetime.now(timezone.utc) - timedelta(days=days)).isoformat()


def env_int(name, default):
    try:
        return int(os.environ.get(name) or default)
    except ValueError:
        return default


class HardTimeout(BaseException):
    """alarm 이 던진다. Exception 이 아니어야 파서의 except Exception 에 삼켜지지 않는다 — 삼켜지면 그 줄을 건너뛴 채
    오프셋이 저장돼 다시 읽지 않는다. 트랜잭션은 롤백되고 다음 색인이 같은 자리부터 다시 읽는다."""


@contextlib.contextmanager
def alarm(seconds):
    """seconds 뒤 HardTimeout. 한 줄이 아주 긴 파일에서도 훅이 제한 시간을 넘지 않게 하는 마지막 안전판."""
    def _raise(signum, frame):
        raise HardTimeout("budget")
    old = signal.signal(signal.SIGALRM, _raise)
    signal.alarm(max(1, int(seconds)))
    try:
        yield
    finally:
        signal.alarm(0)
        signal.signal(signal.SIGALRM, old)


# ---------------------------------------------------------------- DB
class Tx:
    """BEGIN IMMEDIATE … COMMIT. 오프셋을 읽을 때부터 쓰기 잠금을 잡아, 동시에 도는 색인이 같은 줄을 두 번 넣지 못하게 한다."""

    def __init__(self, con):
        self.con = con

    def __enter__(self):
        self.con.execute("BEGIN IMMEDIATE")
        return self.con

    def __exit__(self, et, ev, tb):
        if et is None:
            self.con.execute("COMMIT")
        else:
            try:
                self.con.execute("ROLLBACK")
            except sqlite3.Error:
                pass
        return False


def secure_paths():
    """색인은 원본 세션 기록(0600)의 사본이다 — 같은 맥의 다른 계정이 읽지 못하게 폴더 0700·파일 0600 으로 맞춘다."""
    for path, mode in [(TC_HOME, 0o700)] + [(p, 0o600) for p in [DB_PATH, DB_PATH + "-wal", DB_PATH + "-shm"]
                                            + glob.glob(DB_PATH + ".bak-*")]:
        try:
            if os.path.exists(path) and (os.stat(path).st_mode & 0o777) != mode:
                os.chmod(path, mode)
        except OSError as e:
            debug(f"chmod {path}: {e}")


def connect(timeout=10.0):
    os.makedirs(TC_HOME, mode=0o700, exist_ok=True)
    con = sqlite3.connect(DB_PATH, timeout=timeout, isolation_level=None)
    # 새 DB 를 여러 프로세스가 동시에 WAL 로 바꾸면 busy timeout 을 기다리지 않고 바로 locked 가 난다 → 필요할 때만, 재시도하며
    for _ in range(int(timeout * 10) + 1):
        try:
            if con.execute("PRAGMA journal_mode").fetchone()[0] != "wal":
                con.execute("PRAGMA journal_mode=WAL")
            break
        except sqlite3.OperationalError as e:
            if "locked" not in str(e):
                raise
            time.sleep(0.1)
    con.execute("PRAGMA synchronous=NORMAL")
    if schema_version(con) < SCHEMA:
        migrate(con)
    secure_paths()
    return con


def schema_version(con):
    try:
        row = con.execute("SELECT v FROM meta WHERE k='schema'").fetchone()
    except sqlite3.OperationalError:
        return 0
    return int(row[0]) if row else 0


def migrate(con):
    """빈 DB·v1 → v2. 두 프로세스가 동시에 올려도 한쪽만 적용되게 잠금 안에서 다시 확인한다."""
    with Tx(con):
        con.execute("CREATE TABLE IF NOT EXISTS files(path TEXT PRIMARY KEY, offset INTEGER NOT NULL DEFAULT 0,"
                    " size INTEGER NOT NULL DEFAULT 0, mtime REAL NOT NULL DEFAULT 0, agent TEXT, session_id TEXT,"
                    " project TEXT, indexed_at REAL)")
        con.execute("CREATE TABLE IF NOT EXISTS entries(id INTEGER PRIMARY KEY, agent TEXT NOT NULL, project TEXT,"
                    " session_id TEXT NOT NULL, ts TEXT NOT NULL, role TEXT NOT NULL, text TEXT NOT NULL, path TEXT, line INTEGER)")
        con.execute("CREATE INDEX IF NOT EXISTS ix_entries_session ON entries(session_id, ts)")
        con.execute("CREATE INDEX IF NOT EXISTS ix_entries_project_ts ON entries(project, ts)")
        con.execute("CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT)")
        if schema_version(con) >= SCHEMA:
            return
        if not con.execute("SELECT v FROM meta WHERE k='tokenizer'").fetchone():
            tok = "trigram"
            try:
                con.execute("CREATE VIRTUAL TABLE fts USING fts5(text, content='entries', content_rowid='id', tokenize='trigram')")
            except sqlite3.OperationalError:
                tok = "unicode61"
                con.execute("CREATE VIRTUAL TABLE fts USING fts5(text, content='entries', content_rowid='id', tokenize='unicode61')")
            con.execute("INSERT INTO meta(k,v) VALUES('tokenizer',?)", (tok,))
        con.execute("CREATE TRIGGER IF NOT EXISTS entries_ai AFTER INSERT ON entries BEGIN"
                    " INSERT INTO fts(rowid, text) VALUES (new.id, new.text); END")
        con.execute("CREATE TRIGGER IF NOT EXISTS entries_ad AFTER DELETE ON entries BEGIN"
                    " INSERT INTO fts(fts, rowid, text) VALUES('delete', old.id, old.text); END")
        con.execute("CREATE TRIGGER IF NOT EXISTS entries_au AFTER UPDATE OF text ON entries BEGIN"
                    " INSERT INTO fts(fts, rowid, text) VALUES('delete', old.id, old.text);"
                    " INSERT INTO fts(rowid, text) VALUES (new.id, new.text); END")
        cols = {r[1] for r in con.execute("PRAGMA table_info(files)")}
        if "lines" not in cols:  # NULL = 아직 모름 → 다음 색인 때 오프셋까지의 줄 수를 센다
            con.execute("ALTER TABLE files ADD COLUMN lines INTEGER")
        if "forgotten" not in cols:
            con.execute("ALTER TABLE files ADD COLUMN forgotten INTEGER NOT NULL DEFAULT 0")
        con.execute("CREATE TABLE IF NOT EXISTS sessions(session_id TEXT PRIMARY KEY, agent TEXT, origin TEXT, title TEXT)")
        con.execute("INSERT OR REPLACE INTO meta(k,v) VALUES('schema',?)", (str(SCHEMA),))


def tokenizer(con):
    row = con.execute("SELECT v FROM meta WHERE k='tokenizer'").fetchone()
    return row[0] if row else "unicode61"


# ---------------------------------------------------------------- 원천 파서
def claude_text(content):
    """Claude 메시지 content(str | list) → 사람이 읽을 텍스트. 도구 결과는 제외."""
    if isinstance(content, str):
        return content
    parts = []
    if isinstance(content, list):
        for c in content:
            if isinstance(c, dict) and c.get("type") == "text":
                parts.append(str(c.get("text", "")))
    return "\n".join(parts)


def parse_claude_line(o, state):
    """한 줄 → [(role, text), …] 또는 None. state 에 cwd·session·entrypoint 를 누적한다."""
    if o.get("cwd") and not state.get("project"):
        state["project"] = o["cwd"]
    if o.get("sessionId") and not state.get("session_id"):
        state["session_id"] = o["sessionId"]
    if o.get("entrypoint") and not state.get("origin"):
        state["origin"] = o["entrypoint"]
    if o.get("isSidechain"):
        return None
    t = o.get("type")
    if t == "user":
        m = o.get("message") or {}
        text = claude_text(m.get("content"))
        if not text.strip():
            return None
        if o.get("isCompactSummary"):
            return [("summary", text)]
        if o.get("isMeta") or o.get("toolDenialKind") or any(mk in text for mk in SKIP_MARKERS):
            return None
        return [("user", text)]
    if t == "assistant":
        m = o.get("message") or {}
        out = []
        for c in (m.get("content") or []):
            if not isinstance(c, dict):
                continue
            if c.get("type") == "text" and str(c.get("text", "")).strip():
                out.append(("assistant", str(c["text"])))
            elif c.get("type") == "tool_use":
                name = c.get("name", "?")
                inp = c.get("input") or {}
                detail = ""
                if name == "Bash":
                    detail = str(inp.get("command", "")).strip().split("\n")[0]
                elif name in ("Read", "Edit", "Write", "MultiEdit", "NotebookEdit"):
                    detail = str(inp.get("file_path") or inp.get("notebook_path") or "")
                elif name in ("Grep", "Glob"):
                    detail = f"{inp.get('pattern', '')} {inp.get('path', '')}".strip()
                elif name == "Skill":
                    detail = str(inp.get("skill", ""))
                elif name == "Agent":
                    detail = str(inp.get("description", ""))[:120]
                out.append(("tool", f"{name} {detail}".strip()))
        return out or None
    return None


def codex_origin(meta):
    """session_meta → origin. 서브에이전트·exec 는 사람이 연 세션이 아니다."""
    src = meta.get("source")
    if isinstance(src, dict) and "subagent" in src:
        return "codex_subagent"
    if src == "exec":
        return "codex_exec"
    return meta.get("originator")


def parse_codex_line(o, state):
    t = o.get("type")
    p = o.get("payload") or {}
    if t == "session_meta":
        state["project"] = p.get("cwd") or state.get("project")
        state["session_id"] = p.get("id") or state.get("session_id")
        state["origin"] = codex_origin(p) or state.get("origin")
        return None
    if t == "turn_context" and p.get("cwd") and not state.get("project"):
        state["project"] = p["cwd"]
        return None
    if t == "response_item":
        pt = p.get("type")
        if pt == "message":
            role = p.get("role")
            if role not in ("user", "assistant"):
                return None
            parts = []
            for c in (p.get("content") or []):
                if not (isinstance(c, dict) and c.get("type") in ("input_text", "output_text")):
                    continue
                frag = str(c.get("text", ""))
                if role == "user":
                    head = frag.lstrip()
                    if head.startswith(CODEX_GUARDIAN):
                        return None
                    if head.startswith(CODEX_SKIP_FRAGMENTS):
                        continue
                    frag = CODEX_STRIP.sub("", frag)
                if frag.strip():
                    parts.append(frag.strip())
            text = "\n".join(parts)
            if not text:
                return None
            return [(role, text)]
        if pt in ("function_call", "custom_tool_call", "local_shell_call"):
            name = p.get("name") or pt
            args = p.get("arguments") or p.get("input") or ""
            if isinstance(args, str):
                try:
                    a = json.loads(args)
                    args = a.get("command") or a.get("cmd") or args
                except Exception:
                    m = re.search(r'cmd\s*:\s*"((?:[^"\\]|\\.)*)"', args)
                    if m:
                        args = m.group(1).encode().decode("unicode_escape", "ignore")
            if isinstance(args, list):
                args = " ".join(map(str, args))
            first = str(args).strip().splitlines()[0] if str(args).strip() else ""
            return [("tool", f"{name} {first}".strip())]
    return None


def line_ts(o, fallback):
    ts = o.get("timestamp")
    if isinstance(ts, str) and ts:
        return ts
    return fallback


# ---------------------------------------------------------------- 색인
class Budget:
    def __init__(self, seconds):
        self.deadline = time.time() + seconds if seconds else None

    def over(self):
        return self.deadline is not None and time.time() > self.deadline


def discover_sources(cfg):
    """(agent, path) 목록. 최신 수정 순."""
    out = []
    excl = set(cfg.get("exclude_project_dirs") or [])
    for d in glob.glob(os.path.join(CLAUDE_DIR, "*")):
        if os.path.basename(d) in excl:
            continue
        for f in glob.glob(os.path.join(d, "*.jsonl")):
            out.append(("claude", f))
    for f in glob.glob(os.path.join(CODEX_DIR, "**", "*.jsonl"), recursive=True):
        out.append(("codex", f))
    # Cowork(데스크톱 로컬 에이전트): <계정>/<조직>/local_<id>/.claude/projects/<vm-cwd>/<uuid>.jsonl — audit.jsonl·subagents 는 뺀다
    for f in glob.glob(os.path.join(COWORK_DIR, "*", "*", "local_*", ".claude", "projects", "*", "*.jsonl")):
        out.append(("cowork", f))
    for d in cfg.get("extra_markdown_dirs") or []:
        for f in glob.glob(os.path.join(os.path.expanduser(d), "**", "*.md"), recursive=True):
            out.append(("markdown", f))

    def mtime(ap):
        try:
            return os.path.getmtime(ap[1])
        except OSError:
            return 0
    out.sort(key=mtime, reverse=True)
    return out


def cowork_meta(path):
    """Cowork 세션 파일 옆의 local_<id>.json 에서 제목과 사용자가 고른 폴더(→ 프로젝트)를 읽는다."""
    local = path
    for _ in range(4):
        local = os.path.dirname(local)
    try:
        with open(local + ".json", encoding="utf-8") as fh:
            meta = json.load(fh)
    except Exception:
        return {}
    out = {"title": meta.get("title") or None}
    for f in meta.get("userSelectedFolders") or []:
        p = f if isinstance(f, str) else (f.get("path") if isinstance(f, dict) else None)
        if p:
            out["project"] = p.rstrip("/") or "/"
            break
    return out


def count_newlines(path, upto):
    n = 0
    with open(path, "rb") as fh:
        left = upto
        while left > 0:
            b = fh.read(min(left, 1 << 20))
            if not b:
                break
            n += b.count(b"\n")
            left -= len(b)
    return n


def unchanged(size, mtime, st):
    return size == st.st_size and abs(mtime - st.st_mtime) < 1e-6


FILES_UPSERT = (
    "INSERT INTO files(path, offset, size, mtime, agent, session_id, project, indexed_at, lines) VALUES(?,?,?,?,?,?,?,?,?)"
    " ON CONFLICT(path) DO UPDATE SET offset=excluded.offset, size=excluded.size, mtime=excluded.mtime, agent=excluded.agent,"
    " session_id=excluded.session_id, project=excluded.project, indexed_at=excluded.indexed_at, lines=excluded.lines"
)


def index_file(con, agent, path, budget, reset=False):
    """한 파일을 기억된 오프셋부터 읽어 새 줄만 넣는다. reset 이면 그 파일의 항목을 지우고 처음부터."""
    try:
        st = os.stat(path)
    except OSError:
        return 0
    if not reset:  # 잠금 없이 빠르게 걸러낸다 — 대부분의 파일은 여기서 끝난다
        row = con.execute("SELECT size, mtime, forgotten FROM files WHERE path=?", (path,)).fetchone()
        if row and (row[2] or unchanged(row[0], row[1], st)):
            return 0
    with Tx(con):
        if reset:
            con.execute("DELETE FROM entries WHERE path=?", (path,))
            con.execute("UPDATE files SET offset=0, size=0, mtime=0, lines=0, session_id=NULL, project=NULL"
                        " WHERE path=? AND forgotten=0", (path,))
        row = con.execute("SELECT offset, size, mtime, session_id, project, lines, forgotten FROM files WHERE path=?",
                          (path,)).fetchone()
        if row and (row[6] or unchanged(row[1], row[2], st)):
            return 0
        if agent == "markdown":
            return index_markdown(con, path, st)
        return index_lines(con, agent, path, st, row, budget)


def index_lines(con, agent, path, st, row, budget):
    offset = row[0] if row else 0
    lines = row[5] if row else 0
    state = {"session_id": row[3] if row else None, "project": row[4] if row else None}
    if st.st_size < offset:  # 잘렸거나 다시 쓰인 파일 → 처음부터
        con.execute("DELETE FROM entries WHERE path=?", (path,))
        offset, lines = 0, 0
        state = {"session_id": None, "project": None}
    if lines is None:  # v1 에서 넘어온 파일 — 오프셋까지의 줄 수를 센다
        lines = count_newlines(path, offset)
    if agent == "cowork":
        meta = cowork_meta(path)
        state["origin"] = "cowork"
        state["title"] = meta.get("title")
        if meta.get("project") and not state.get("project"):
            state["project"] = meta["project"]
    parse = parse_codex_line if agent == "codex" else parse_claude_line
    fallback_ts = datetime.fromtimestamp(st.st_mtime, tz=timezone.utc).isoformat()
    added = 0
    with open(path, "rb") as fh:
        fh.seek(offset)
        while not budget.over():
            pos = fh.tell()
            raw = fh.readline()
            if not raw:
                break
            if not raw.endswith(b"\n"):  # 아직 쓰는 중인 마지막 줄 — 다음 색인에 재처리
                fh.seek(pos)
                break
            lines += 1
            try:
                o = json.loads(raw.decode("utf-8", "ignore"))
            except Exception:
                continue
            if not isinstance(o, dict):
                continue
            items = parse(o, state)
            if not items:
                continue
            sid = state.get("session_id") or os.path.splitext(os.path.basename(path))[0]
            ts = line_ts(o, fallback_ts)
            for role, text in items:
                con.execute(
                    "INSERT INTO entries(agent, project, session_id, ts, role, text, path, line) VALUES(?,?,?,?,?,?,?,?)",
                    (agent, state.get("project"), sid, ts, role, clean(text, role), path, lines),
                )
                added += 1
        new_offset = fh.tell()
    done = new_offset >= st.st_size
    con.execute(FILES_UPSERT, (path, new_offset, st.st_size if done else new_offset, st.st_mtime if done else 0,
                               agent, state.get("session_id"), state.get("project"), time.time(), lines))
    # 프로젝트가 늦게 확정된 경우 앞 항목 보정
    if state.get("project"):
        con.execute("UPDATE entries SET project=? WHERE path=? AND project IS NULL", (state["project"], path))
    sid = state.get("session_id")
    if sid and (state.get("origin") or state.get("title")):
        con.execute(
            "INSERT INTO sessions(session_id, agent, origin, title) VALUES(?,?,?,?) ON CONFLICT(session_id) DO UPDATE SET"
            " origin=COALESCE(excluded.origin, sessions.origin), title=COALESCE(excluded.title, sessions.title)",
            (sid, agent, state.get("origin"), state.get("title")),
        )
    return added


def index_markdown(con, path, st):
    con.execute("DELETE FROM entries WHERE path=?", (path,))
    with open(path, encoding="utf-8", errors="ignore") as fh:
        text = fh.read()
    ts = datetime.fromtimestamp(st.st_mtime, tz=timezone.utc).isoformat()
    m = re.search(r"(20\d\d-\d\d-\d\d)", os.path.basename(path))
    if m:
        ts = m.group(1) + "T00:00:00+00:00"
    sid = "md:" + os.path.relpath(path, HOME)
    n = 0
    for i, ch in enumerate(re.split(r"\n(?=#{1,3} )", text)):
        ch = ch.strip()
        if len(ch) < 40:
            continue
        con.execute(
            "INSERT INTO entries(agent, project, session_id, ts, role, text, path, line) VALUES(?,?,?,?,?,?,?,?)",
            ("markdown", os.path.dirname(path), sid, ts, "note", clip(redact(ch), NOTE_CAP), path, i),
        )
        n += 1
    con.execute(FILES_UPSERT, (path, st.st_size, st.st_size, st.st_mtime, "markdown", sid, os.path.dirname(path),
                               time.time(), 0))
    return n


def run_index(con, budget):
    total = files = 0
    for agent, path in discover_sources(load_config()):
        if budget.over():
            break
        n = index_file(con, agent, path, budget)
        if n:
            total += n
            files += 1
    con.execute("INSERT OR REPLACE INTO meta(k,v) VALUES('last_index', ?)", (datetime.now(timezone.utc).isoformat(),))
    return total, files


def auto_index(seconds=2.0):
    """조회 전에 짧게 색인한다 — 훅이 없는 쪽(Codex·데스크톱 MCP)도 최신 기록을 보게. 잠겨 있으면 건너뛴다."""
    if os.environ.get("TIMECAPSULE_NO_AUTO_INDEX"):
        return
    try:
        con = connect(timeout=1.0)
        try:
            run_index(con, Budget(seconds))
        finally:
            con.close()
    except Exception as e:
        debug(f"auto-index skipped: {e.__class__.__name__}: {e}")


def cmd_index(args):
    con = connect()
    budget = Budget(args.timeout if args.timeout else (4 if args.quick else None))
    total, files = run_index(con, budget)
    if not args.quiet:
        print(f"indexed {total} entries from {files} files" + (" (budget hit)" if budget.over() else ""))


# ---------------------------------------------------------------- 프로젝트 범위
def norm_project(p):
    return os.path.abspath(os.path.expanduser(p)).rstrip("/") or "/"


def in_cwd(project, p):
    return bool(project) and (project == p or project.startswith(p + "/"))


def touched_sessions(con, p):
    """작업 폴더가 달라도 도구 호출(파일 경로·명령)에 이 경로를 TOUCH_MIN 번 이상 남긴 세션 → {session_id: 횟수}."""
    if p == "/" or p == HOME or HOME.startswith(p + "/"):
        return {}
    needles = [p]
    if p.startswith(HOME + "/"):
        needles.append("~" + p[len(HOME):])
    rx = re.compile("(?:" + "|".join(re.escape(n) for n in needles) + r")(?![\w.\-])")  # /app 이 /app2·/app-x 에 걸리지 않게
    sql = ("SELECT session_id, text FROM entries WHERE role='tool' AND ("
           + " OR ".join(["instr(text, ?) > 0"] * len(needles)) + ")")
    counts = {}
    for sid, text in con.execute(sql, needles):
        if rx.search(text):
            counts[sid] = counts.get(sid, 0) + 1
    return {s: n for s, n in counts.items() if n >= TOUCH_MIN}


def scope_sql(con, project, touched=True, a="e."):
    """프로젝트 범위 조건 → (where, params, 경로를 다룬 세션 맵).

    같은 프로젝트로 보는 것: 세션 cwd 가 P 이거나 P 의 하위 · 도구 기록에 P 를 TOUCH_MIN 번 이상 남긴 세션
    · claude-mem 이관분 중 프로젝트 이름이 P 의 폴더 이름과 같은 것. 상위 폴더(홈 포함)에서 연 세션은 넣지 않는다.
    """
    if not project:
        return "1=1", (), {}
    p = norm_project(project)
    if p == "/":
        return "1=1", (), {}
    parts = [f"{a}project = ?", f"substr({a}project, 1, ?) = ?", f"({a}agent = 'claude-mem' AND {a}project = ?)"]
    params = [p, len(p) + 1, p + "/", os.path.basename(p)]
    tmap = touched_sessions(con, p) if touched else {}
    if tmap:
        parts.append(f"{a}session_id IN (SELECT value FROM json_each(?))")
        params.append(json.dumps(sorted(tmap)))
    return "(" + " OR ".join(parts) + ")", tuple(params), tmap


def excluded_session(args):
    """지금 이 세션은 결과에서 뺀다 — 자기 발화·자기 검색 명령이 과거 기록을 밀어내지 않게."""
    if getattr(args, "include_current", False):
        return None
    return getattr(args, "exclude_session", None) or os.environ.get("CLAUDE_CODE_SESSION_ID") or None


def session_meta(con, sids):
    if not sids:
        return {}
    rows = con.execute("SELECT session_id, origin, title FROM sessions WHERE session_id IN (SELECT value FROM json_each(?))",
                       (json.dumps(list(sids)),))
    return {s: (o, t) for s, o, t in rows}


# ---------------------------------------------------------------- 조회
def fmt_ts(ts):
    try:
        d = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
        return d.strftime("%m-%d %H:%M")
    except Exception:
        return (ts or "")[:16]


def short_project(p):
    if not p:
        return "-"
    if p == HOME or p.startswith(HOME + "/"):
        return "~" + p[len(HOME):]
    return p


def src_ref(path, line):
    if not path:
        return "-"
    if not os.path.exists(path):
        return f"{short_project(path)} (원본 없음)"
    return f"{short_project(path)}:{line}" if line else short_project(path)


def make_snippet(text, terms, width=60):
    flat = " ".join(text.split())
    low = flat.lower()
    hits = [(low.find(t.lower()), t) for t in terms]
    hits = [h for h in hits if h[0] >= 0]
    if not hits:
        return flat[: width * 2]
    pos = min(h[0] for h in hits)
    start, end = max(0, pos - width), min(len(flat), pos + width)
    seg = flat[start:end]
    alts = "|".join(re.escape(t) for t in sorted({t for _, t in hits}, key=len, reverse=True))
    seg = re.sub(alts, lambda m: "[" + m.group(0) + "]", seg, flags=re.I)
    return ("…" if start > 0 else "") + seg + ("…" if end < len(flat) else "")


def match_sql(con, terms):
    """검색어 → (FROM 절, WHERE 조각, 파라미터, snippet 식, long_t, short_t).

    trigram 은 3글자 미만을 못 찾는다 → 짧은 단어는 본문 부분 일치(instr)로 거른다(한국어 2글자 단어: 배포·오류·훅).
    """
    tok = tokenizer(con)
    if tok == "trigram":
        long_t = [t for t in terms if len(t) >= 3]
        short_t = [t for t in terms if len(t) < 3]
    else:
        long_t, short_t = list(terms), []
    params = []
    if long_t:
        frm = " FROM fts JOIN entries e ON e.id = fts.rowid WHERE fts MATCH ?"
        params.append(" AND ".join('"' + t.replace('"', '""') + '"' for t in long_t))
        snip = "snippet(fts, 0, '[', ']', '…', 64)"
    else:
        frm = " FROM entries e WHERE 1=1"
        snip = "NULL"
    where = ""
    for t in short_t:
        where += " AND instr(lower(e.text), ?) > 0"
        params.append(t.lower())
    return frm, where, params, snip, long_t, short_t


def not_self_query_sql():
    """과거에 돌린 timecapsule 명령(도구 기록)이 결과를 채우지 않게 하는 WHERE 조각."""
    return (" AND NOT (e.role = 'tool' AND (" + " OR ".join(["instr(e.text, ?) > 0"] * len(SELF_QUERY)) + "))",
            list(SELF_QUERY))


def prompt_terms(prompt, cap=6):
    """프롬프트 → 검색어. 영문·식별자는 2자 이상, 한국어는 조사를 떼고 2자 이상, 상투어는 뺀다. 긴 말(더 특정적)부터 cap 개."""
    out, seen = [], set()
    for w in re.findall(r"[A-Za-z][A-Za-z0-9_.\-]+|[가-힣]{2,}", prompt):
        w = w.strip("._-")
        if re.fullmatch(r"[가-힣]+", w):
            if REQUEST_END.match(w):
                continue
            for suf in KO_SUFFIXES:
                if w.endswith(suf):
                    # 조사를 떼고 2글자 이상 남으면 어간을 쓴다. 1글자만 남으면(웹에도·앱은) 검색어로 못 쓰니 통째로 버린다
                    w = w[: -len(suf)] if len(w) - len(suf) >= 2 else ""
                    break
        lw = w.lower()
        if len(w) < 2 or lw in STOP_TERMS or lw in seen:
            continue
        seen.add(lw)
        out.append(w)
    out.sort(key=len, reverse=True)
    return out[:cap]


def prompt_context(con, prompt, cwd, exclude_sid=None, days=PROMPT_DAYS, max_sessions=PROMPT_SESSIONS, max_chars=PROMPT_CHARS):
    """프롬프트와 닿는 과거 세션 몇 개 → 주입 텍스트(없으면 ""). 전역 범위(다른 작업 폴더·Codex 포함), 같은 프로젝트를 앞에.

    검색은 특정적인 조합부터 — 모든 말 AND → 둘씩 짝 → 한두 말이면 낱말. 자동 실행 세션·지금 세션은 뺀다.
    """
    text = (prompt or "").strip()
    if len(text) < PROMPT_MIN_CHARS or text.startswith("/") or any(m in text for m in SKIP_MARKERS):
        return ""
    terms = prompt_terms(text)
    # 말이 하나뿐이면 4글자 이상일 때만 찾는다 — 「커밋」「배포」 같은 흔한 말 하나로 무관한 세션을 끌어오지 않게
    if not terms or (len(terms) == 1 and len(terms[0]) < 4):
        return ""
    p = norm_project(cwd) if cwd else None
    plans = [terms] if len(terms) > 1 else []
    if len(terms) > 2:
        plans += [list(c) for c in itertools.combinations(terms, 2)][:10]
    if len(terms) <= 2:
        plans += [[t] for t in terms]
    found = {}
    auto = ",".join("?" * len(AUTO_ORIGINS))
    for plan in plans:
        frm, where, params, snip, long_t, short_t = match_sql(con, plan)
        where += " AND e.role IN ('user','assistant','summary') AND e.agent IN ('claude','codex','cowork')"
        where += " AND e.session_id NOT IN (SELECT session_id FROM sessions WHERE origin IN (" + auto + "))"
        params += list(AUTO_ORIGINS)
        if days:
            where += " AND e.ts >= ?"
            params.append(since(days))
        if exclude_sid:
            where += " AND e.session_id != ?"
            params.append(exclude_sid)
        order = "bm25(fts), e.ts DESC" if long_t else "e.ts DESC"
        sql = "SELECT e.ts, e.agent, e.project, e.session_id, " + snip + ", e.text" + frm + where + " ORDER BY " + order + " LIMIT 40"
        rows = con.execute(sql, params).fetchall()
        rows.sort(key=lambda r: 0 if (p and in_cwd(r[2], p)) else 1)  # 같은 프로젝트 먼저 — 안정 정렬이라 관련도 순은 유지
        for ts_, agent, proj, sid, snippet, body in rows:
            if sid in found:
                continue
            seg = snippet if (snippet and not short_t) else make_snippet(body, short_t + long_t)
            found[sid] = (plan, ts_, agent, proj, " ".join(seg.split()))
            if len(found) >= max_sessions:
                break
        if len(found) >= max_sessions:
            break
    if not found:
        return ""
    lines = [HEADER, f"(이 프롬프트와 닿는 과거 세션 — 검색어: {' '.join(terms)}. 전개는 `timecapsule session <id>`)"]
    for sid, (plan, ts_, agent, proj, seg) in found.items():
        fu, la = first_last(con, sid)
        block = (f"\n## {fmt_ts(ts_)} · {agent} · {short_project(proj)} · {sid[:8]} · 맞은 말: {' '.join(plan)}\n"
                 f"- 요청: {' '.join(fu.split())[:200] or '-'}\n- 대목: {seg[:220]}\n- 마지막 결론: {' '.join(la.split())[:240] or '-'}")
        if sum(len(x) for x in lines) + len(block) > max_chars:
            break
        lines.append(block)
    return "\n".join(lines) if len(lines) > 2 else ""


def cmd_search(args):
    if not args.no_index:
        auto_index()
    con = connect()
    terms = [t for t in args.query.split() if t]
    if not terms:
        raise ValueError("질의가 비었다")
    frm, where, params, snip, long_t, short_t = match_sql(con, terms)
    sw, sp, _ = scope_sql(con, args.project)
    where += " AND " + sw
    params += list(sp)
    if args.agent:
        where += " AND e.agent = ?"
        params.append(args.agent)
    if args.role:
        where += " AND e.role = ?"
        params.append(args.role)
    if args.days:
        where += " AND e.ts >= ?"
        params.append(since(args.days))
    cur = excluded_session(args)
    if cur:
        where += " AND e.session_id != ?"
        params.append(cur)
    nq, nparams = not_self_query_sql()  # 과거에 돌린 timecapsule 명령 자체가 결과를 채우지 않게
    where += nq
    params += nparams
    order = "bm25(fts), e.ts DESC" if (args.sort == "rank" and long_t) else "e.ts DESC"
    cap = max(args.limit * 25, 500) if args.per_session else args.limit
    sql = ("SELECT e.ts, e.agent, e.project, e.session_id, e.role, " + snip + ", e.path, e.line, e.text"
           + frm + where + " ORDER BY " + order + " LIMIT ?")
    rows, per = [], {}
    for r in con.execute(sql, params + [cap]):
        if args.per_session and per.get(r[3], 0) >= args.per_session:
            continue
        per[r[3]] = per.get(r[3], 0) + 1
        rows.append(r)
        if len(rows) >= args.limit:
            break
    out = []
    for ts, agent, project, sid, role, snippet, path, line, text in rows:
        s = snippet if (snippet and not short_t) else make_snippet(text, short_t + long_t)
        out.append((ts, agent, project, sid, role, " ".join(s.split()), path, line))
    if args.json:
        print(json.dumps([dict(ts=r[0], agent=r[1], project=r[2], session=r[3], role=r[4], snippet=r[5], path=r[6], line=r[7])
                          for r in out], ensure_ascii=False))
        return
    print(HEADER)
    if not out:
        print(f"(결과 없음: {args.query!r})")
        return
    for ts, agent, project, sid, role, snip, path, line in out:
        print(f"[{fmt_ts(ts)}] {agent} · {short_project(project)} · {role} · {sid[:8]}\n    {snip}")
        if args.src:
            print(f"    ↳ {src_ref(path, line)}")


def first_last(con, sid):
    # 첫 사람 말 — 데스크톱 앱이 앞에 넣는 <external_…> 같은 태그 줄은 건너뛴다(없으면 그거라도)
    rows = con.execute("SELECT text FROM entries WHERE session_id=? AND role='user' ORDER BY ts, id LIMIT 5", (sid,)).fetchall()
    fu = next((r for r in rows if not r[0].lstrip().startswith("<")), rows[0] if rows else None)
    la = con.execute("SELECT text FROM entries WHERE session_id=? AND role='assistant' ORDER BY ts DESC, id DESC LIMIT 1",
                     (sid,)).fetchone()
    return (fu[0] if fu else ""), (la[0] if la else "")


def cmd_recent(args):
    if not args.no_index:
        auto_index()
    con = connect()
    project = None if args.all else args.project
    where, params, tmap = scope_sql(con, project)
    params = list(params)
    where += " AND e.agent NOT IN ('markdown', 'claude-mem')"
    if args.days:
        where += " AND e.ts >= ?"
        params.append(since(args.days))
    if not args.include_auto:
        where += (" AND e.session_id NOT IN (SELECT session_id FROM sessions WHERE origin IN ("
                  + ",".join("?" * len(AUTO_ORIGINS)) + "))")
        params += list(AUTO_ORIGINS)
    cur = excluded_session(args)
    if cur:
        where += " AND e.session_id != ?"
        params.append(cur)
    sql = ("SELECT e.session_id, MAX(e.agent), MAX(e.project), MIN(e.ts), MAX(e.ts), COUNT(*), SUM(e.role='tool')"
           " FROM entries e WHERE " + where + " GROUP BY e.session_id HAVING SUM(e.role='user') > 0"
           " ORDER BY MAX(e.ts) DESC LIMIT ?")
    rows = con.execute(sql, params + [args.limit]).fetchall()
    meta = session_meta(con, [r[0] for r in rows])
    p = norm_project(project) if project else None

    def touch_note(sid, proj):
        if p and sid in tmap and not in_cwd(proj, p):
            return tmap[sid]
        return 0

    if args.json:
        out = []
        for sid, agent, proj, t0, t1, n, ntool in rows:
            fu, la = first_last(con, sid)
            origin, title = meta.get(sid, (None, None))
            out.append(dict(session=sid, agent=agent, project=proj, start=t0, end=t1, entries=n, tools=ntool,
                            origin=origin, title=title, path_mentions=touch_note(sid, proj),
                            first_user=fu, last_assistant=la))
        print(json.dumps(out, ensure_ascii=False))
        return
    lines = [HEADER, "(각 세션은 첫 요청·마지막 결론만 발췌. 전개는 `timecapsule session <id>`)"]
    if not rows:
        lines.append("(이 프로젝트의 세션 기록 없음)")
    for sid, agent, proj, t0, t1, n, ntool in rows:
        fu, la = first_last(con, sid)
        fu = " ".join(fu.split())[:240]
        la = " ".join(la.split())[:360]
        title = meta.get(sid, (None, None))[1]
        k = touch_note(sid, proj)
        block = (f"\n## {fmt_ts(t0)} → {fmt_ts(t1)} · {agent} · {short_project(proj)} · {sid[:8]} · 항목 {n} (도구 {ntool or 0})"
                 + (f" · 작업폴더 밖(이 경로 언급 {k}회)" if k else "") + "\n"
                 + (f"- 제목: {title}\n" if title else "")
                 + f"- 요청: {fu or '-'}\n- 마지막 결론: {la or '-'}")
        if sum(len(x) for x in lines) + len(block) > args.max_chars:
            lines.append("\n(길이 상한으로 이하 생략)")
            break
        lines.append(block)
    print("\n".join(lines))


def match_sessions(con, prefix, limit=20):
    return [r[0] for r in con.execute(
        "SELECT DISTINCT session_id FROM entries WHERE session_id >= ? AND session_id < ? LIMIT ?",
        (prefix, prefix + "\uffff", limit))]


def describe_session(con, sid):
    agent, proj, t0, t1, n = con.execute(
        "SELECT MAX(agent), MAX(project), MIN(ts), MAX(ts), COUNT(*) FROM entries WHERE session_id=?", (sid,)).fetchone()
    return agent, proj, t0, t1, n


def ambiguous(con, prefix, sids):
    print(f"({len(sids)}개 이상의 세션이 '{prefix}' 로 시작한다 — 더 길게 적어라)")
    for s in sids:
        agent, proj, t0, t1, n = describe_session(con, s)
        fu, _ = first_last(con, s)
        print(f"  {s} · {fmt_ts(t0)} · {agent} · {short_project(proj)} · 항목 {n} · {' '.join(fu.split())[:80]}")


def cmd_session(args):
    con = connect()
    sids = match_sessions(con, args.id)
    if not sids:
        print("(세션 없음)")
        return
    if len(sids) > 1:
        ambiguous(con, args.id, sids)
        return
    sid = sids[0]
    q, params = "FROM entries WHERE session_id=?", [sid]
    if args.role:
        q += " AND role=?"
        params.append(args.role)
    total = con.execute("SELECT COUNT(*) " + q, params).fetchone()[0]
    rows = con.execute("SELECT ts, role, text, path, line " + q + " ORDER BY ts, id LIMIT ? OFFSET ?",
                       params + [args.limit if args.limit else -1, args.offset]).fetchall()
    agent, proj, t0, t1, _ = describe_session(con, sid)
    origin, title = session_meta(con, [sid]).get(sid, (None, None))
    print(HEADER)
    print(f"# {sid} · {agent}" + (f"({origin})" if origin else "") + f" · {short_project(proj)} · {fmt_ts(t0)} → {fmt_ts(t1)}"
          + (f" · {title}" if title else "") + f" · 항목 {total}")
    for ts, role, text, path, line in rows:
        text = " ".join(text.split())
        print(f"[{fmt_ts(ts)}] {role}: {text[: args.width]}")
        if args.src:
            print(f"    ↳ {src_ref(path, line)}")
    shown = args.offset + len(rows)
    if shown < total:
        print(f"(… {total - shown}개 더 — --offset {shown})")


def cmd_tools(args):
    """지난 세션에서 무슨 도구를 썼는지. 서브에이전트 기록은 제외된다."""
    con = connect()
    if args.session:
        where, params = "session_id >= ? AND session_id < ?", (args.session, args.session + "\uffff")
    else:
        where, params, _ = scope_sql(con, args.project, touched=False, a="")
        if args.days:
            where += " AND ts >= ?"
            params += (since(args.days),)
    rows = con.execute("SELECT text FROM entries WHERE role='tool' AND " + where + " ORDER BY ts", params).fetchall()
    counts = {}
    samples = {}
    for (t,) in rows:
        name = t.split(" ", 1)[0]
        counts[name] = counts.get(name, 0) + 1
        if name == "Bash" or name.startswith(("exec", "shell", "local_shell")):
            k = t.split(" ", 1)[1][:80] if " " in t else ""
            if k:
                samples.setdefault(name, []).append(k)
    print(HEADER)
    print(f"도구 호출 {len(rows)}건 (주 에이전트 기록만, 서브에이전트 제외)")
    for name, n in sorted(counts.items(), key=lambda kv: -kv[1])[: args.limit]:
        print(f"  {n:6d}  {name}")
    if args.commands:
        seen = {}
        for name, cmds in samples.items():
            for c in cmds:
                key = " ".join(c.split()[:2])
                seen[key] = seen.get(key, 0) + 1
        print("셸 명령 앞 두 토큰 (상위):")
        for k, n in sorted(seen.items(), key=lambda kv: -kv[1])[: args.limit]:
            print(f"  {n:6d}  {k}")


def path_needles(path):
    """경로 → 도구 기록에서 찾을 문자열. 절대경로·~경로는 둘 다, 상대경로·파일명은 그대로(뒤쪽 일치)."""
    path = path.strip()
    if path.startswith(("/", "~")):
        p = norm_project(path)
        return [p] + (["~" + p[len(HOME):]] if p.startswith(HOME + "/") else [])
    return [path.lstrip("./")]


def cmd_touched(args):
    """이 파일·폴더를 다룬 세션 — 도구 기록(Edit·Read·Bash 명령줄)에 경로가 남은 세션을 모아 요청·결론과 함께."""
    con = connect()
    needles = path_needles(args.path)
    rx = re.compile("(?:" + "|".join(re.escape(n) for n in needles) + r")(?![\w.\-])")  # x.py 가 x.pyc 에 걸리지 않게
    where = "e.role='tool' AND (" + " OR ".join(["instr(e.text, ?) > 0"] * len(needles)) + ")"
    params = list(needles)
    if args.days:
        where += " AND e.ts >= ?"
        params.append(since(args.days))
    nq, nparams = not_self_query_sql()
    where += nq
    params += nparams
    # ponytail: 전수 instr 스캔 — 21만 행에 0.2초. 느려지면 fts MATCH 로 후보를 좁힌다
    rows = con.execute("SELECT e.session_id, e.ts, e.agent, e.project, e.text FROM entries e WHERE " + where + " ORDER BY e.ts",
                       params).fetchall()
    per = {}
    for sid, ts_, agent, proj, text in rows:
        if not rx.search(text):
            continue
        d = per.setdefault(sid, dict(session=sid, agent=agent, project=proj, first=ts_, last=ts_, hits=0, ops=[]))
        d["last"], d["hits"] = ts_, d["hits"] + 1
        op = " ".join(text.split())[:100]
        if op not in d["ops"] and len(d["ops"]) < 3:
            d["ops"].append(op)
    sessions = sorted(per.values(), key=lambda d: d["last"], reverse=True)[: args.limit]
    for d in sessions:
        fu, la = first_last(con, d["session"])
        d["first_user"], d["last_assistant"] = " ".join(fu.split())[:200], " ".join(la.split())[:240]
    if args.json:
        print(json.dumps(sessions, ensure_ascii=False))
        return
    print(HEADER)
    print(f"'{args.path}' 를 다룬 세션 {len(per)}개" + (f" (최근 {args.limit}개만)" if len(per) > args.limit else ""))
    for d in sessions:
        print(f"\n## {fmt_ts(d['first'])} → {fmt_ts(d['last'])} · {d['agent']} · {short_project(d['project'])} · {d['session'][:8]}"
              f" · 언급 {d['hits']}회")
        print(f"- 요청: {d['first_user'] or '-'}\n- 마지막 결론: {d['last_assistant'] or '-'}")
        for op in d["ops"]:
            print(f"- 도구: {op}")


def cmd_lessons(args):
    """사용자 교정 발화 후보 — 검토용 목록. 규칙 파일(CLAUDE.md·AGENTS.md·메모리)에는 사람이 고른 것만 옮긴다."""
    con = connect()
    where = ("e.role='user' AND e.agent IN ('claude','codex','cowork') AND length(e.text) < ? AND substr(ltrim(e.text), 1, 1) != '#'"
             " AND e.session_id NOT IN (SELECT session_id FROM sessions WHERE origin IN (" + ",".join("?" * len(AUTO_ORIGINS)) + "))"
             " AND (" + " OR ".join(["instr(e.text, ?) > 0"] * len(LESSON_PATTERNS)) + ")")
    params = [LESSON_MAX_CHARS] + list(AUTO_ORIGINS) + list(LESSON_PATTERNS)
    if not args.all:
        sw, sp, _ = scope_sql(con, args.project, touched=False)
        where += " AND " + sw
        params += list(sp)
    if args.days:
        where += " AND e.ts >= ?"
        params.append(since(args.days))
    rows = con.execute("SELECT e.ts, e.agent, e.project, e.session_id, e.text FROM entries e WHERE " + where
                       + " ORDER BY e.ts DESC LIMIT ?", params + [args.limit]).fetchall()
    out = []
    for ts_, agent, proj, sid, text in rows:
        flat = " ".join(text.split())
        out.append(dict(ts=ts_, agent=agent, project=proj, session=sid,
                        pattern=next((k for k in LESSON_PATTERNS if k in flat), ""), text=flat))
    if args.json:
        print(json.dumps(out, ensure_ascii=False))
        return
    print(HEADER)
    print(f"교정·규칙 후보 {len(out)}건 — 검토용 목록이다. 규칙 파일에는 사람이 고른 것만 옮긴다.")
    for r in out:
        print(f"\n[{fmt_ts(r['ts'])}] {r['agent']} · {short_project(r['project'])} · {r['session'][:8]} · 「{r['pattern']}」\n    {r['text'][:260]}")


# ---------------------------------------------------------------- 관리
def backup_db(con):
    dst_path = DB_PATH + ".bak-" + datetime.now().strftime("%Y%m%d-%H%M%S")
    dst = sqlite3.connect(dst_path)
    try:
        con.backup(dst)
    finally:
        dst.close()
    os.chmod(dst_path, 0o600)
    return dst_path


def compact_db(con):
    """지운 행의 흔적까지 없앤다 — FTS 세그먼트 병합 · 파일 재작성 · WAL 비우기."""
    con.execute("INSERT INTO fts(fts) VALUES('optimize')")
    con.execute("VACUUM")
    con.execute("PRAGMA wal_checkpoint(TRUNCATE)")


def cmd_forget(args):
    con = connect()
    sids = match_sessions(con, args.id)
    if not sids:
        print("(세션 없음)")
        return
    if len(sids) > 1:
        ambiguous(con, args.id, sids)
        return
    sid = sids[0]
    agent, proj, t0, t1, n = describe_session(con, sid)
    paths = [r[0] for r in con.execute("SELECT DISTINCT path FROM entries WHERE session_id=? AND path IS NOT NULL", (sid,))]
    print(f"대상: {sid} · {agent} · {short_project(proj)} · {fmt_ts(t0)} → {fmt_ts(t1)} · 항목 {n}")
    for p in paths:
        print(f"  원본: {short_project(p)}" + ("" if os.path.exists(p) else " (이미 없음)"))
    if not args.yes:
        print("(시험 실행 — 지우려면 --yes)")
        return
    con.execute("PRAGMA secure_delete=ON")
    with Tx(con):
        con.execute("DELETE FROM entries WHERE session_id=?", (sid,))
        con.execute("DELETE FROM sessions WHERE session_id=?", (sid,))
        for p in paths:
            if agent == "claude-mem" or con.execute("SELECT 1 FROM entries WHERE path=? LIMIT 1", (p,)).fetchone():
                continue  # 다른 세션과 같이 쓰는 원천(claude-mem DB 등)은 표시하지 않는다
            con.execute(FILES_UPSERT, (p, 0, 0, 0, agent, sid, proj, time.time(), None))
            con.execute("UPDATE files SET forgotten=1 WHERE path=?", (p,))  # 원본이 자라도 다시 색인하지 않는다
    compact_db(con)
    print(f"색인에서 {n}개 항목을 지웠다. 이 원본 파일은 앞으로 색인하지 않는다.")
    live = [p for p in paths if os.path.exists(p)]
    if live:
        print("원본 파일은 남아 있다 — 비밀값 때문이라면 직접 지워라:")
        for p in live:
            print(f"  {p}")
    baks = sorted(glob.glob(DB_PATH + ".bak-*"))
    if baks:
        print(f"주의: 백업 {len(baks)}개({os.path.basename(baks[0])} …)에는 이 기록이 그대로 남아 있다.")


def cmd_rebuild(args):
    con = connect()
    rows = con.execute("SELECT path, agent, forgotten FROM files").fetchall()
    live = [(a, p) for p, a, fg in rows if not fg and a in TRANSCRIPT_AGENTS + ("markdown",) and os.path.exists(p)]
    live_set = {p for _, p in live}
    con.execute("CREATE TEMP TABLE IF NOT EXISTS live(path TEXT PRIMARY KEY)")
    con.execute("DELETE FROM live")
    con.executemany("INSERT OR IGNORE INTO live(path) VALUES(?)", [(p,) for p in live_set])
    kept = con.execute("SELECT COUNT(*) FROM entries WHERE path IS NULL OR path NOT IN (SELECT path FROM live)").fetchone()[0]
    print(f"다시 색인: 원본이 있는 파일 {len(live)}개")
    print(f"보존: 원본이 없거나 이관된 기록 {kept}행 — 지우지 않고 새 걸러내기·가림 규칙만 적용한다")
    if not args.yes:
        print("(시험 실행 — 실행하려면 --yes. 시작 전에 DB 백업을 만든다)")
        return
    if not args.no_backup:
        print(f"백업: {backup_db(con)}")
    t0 = time.time()
    added = 0
    for agent, path in live:
        added += index_file(con, agent, path, Budget(None), reset=True)
    dropped = relabeled = masked = 0
    with Tx(con):
        orphans = con.execute("SELECT id, agent, role, text FROM entries"
                              " WHERE path IS NULL OR path NOT IN (SELECT path FROM live)").fetchall()
        for eid, agent, role, text in orphans:
            if agent in ("claude", "cowork") and role == "user":
                if any(mk in text for mk in SKIP_MARKERS):
                    con.execute("DELETE FROM entries WHERE id=?", (eid,))
                    dropped += 1
                    continue
                if text.startswith(CONTINUATION):
                    con.execute("UPDATE entries SET role='summary' WHERE id=?", (eid,))
                    relabeled += 1
            new = redact(text)
            if new != text:
                con.execute("UPDATE entries SET text=? WHERE id=?", (new, eid))
                masked += 1
    more, _ = run_index(con, Budget(None))  # 새로 잡히는 원천(Cowork 등)
    compact_db(con)
    print(f"완료 {time.time() - t0:.0f}초 · 다시 넣은 항목 {added + more} · 보존 기록 중 걸러냄 {dropped} · 요약으로 재분류 {relabeled}"
          f" · 비밀값 재가림 {masked}")


def cmd_stats(args):
    con = connect()
    size = sum(os.path.getsize(p) for p in (DB_PATH, DB_PATH + "-wal") if os.path.exists(p))
    print(f"db: {DB_PATH} ({size // 1024 // 1024} MB) · tokenizer: {tokenizer(con)} · schema {schema_version(con)}")
    last = con.execute("SELECT v FROM meta WHERE k='last_index'").fetchone()
    print(f"last index: {last[0] if last else '-'}")
    for agent, n, s, t0, t1 in con.execute(
        "SELECT agent, COUNT(*), COUNT(DISTINCT session_id), MIN(ts), MAX(ts) FROM entries GROUP BY agent"
    ):
        print(f"{agent:10s} entries {n:7d} · sessions {s:5d} · {t0[:10]} ~ {t1[:10]}")
    origins = con.execute("SELECT COALESCE(origin,'-'), COUNT(*) FROM sessions GROUP BY 1 ORDER BY 2 DESC").fetchall()
    if origins:
        print("session origins: " + ", ".join(f"{o} {n}" for o, n in origins))
    fg = con.execute("SELECT COUNT(*) FROM files WHERE forgotten=1").fetchone()[0]
    if fg:
        print(f"forgotten files: {fg}")
    print("projects (top 10):")
    for p, n in con.execute(
        "SELECT project, COUNT(DISTINCT session_id) FROM entries WHERE project IS NOT NULL GROUP BY project ORDER BY 2 DESC LIMIT 10"
    ):
        print(f"  {n:5d}  {short_project(p)}")


def cmd_migrate_claude_mem(args):
    src = os.path.expanduser(args.db)
    if not os.path.exists(src):
        print(f"없음: {src}")
        return
    con = connect()
    done = con.execute("SELECT COUNT(*) FROM entries WHERE agent='claude-mem'").fetchone()[0]
    if done and not args.force:
        print(f"이미 이관됨 ({done}건). 다시 하려면 --force")
        return
    s = sqlite3.connect(f"file:{src}?mode=ro", uri=True)
    n = 0
    with Tx(con):
        con.execute("DELETE FROM entries WHERE agent='claude-mem'")
        for sid, project, title, subtitle, text, facts, narrative, created in s.execute(
            "SELECT memory_session_id, project, title, subtitle, text, facts, narrative, created_at FROM observations"
        ):
            parts = [x for x in (title, subtitle, narrative or text, facts) if x]
            body = "\n".join(str(x) for x in parts)
            if len(body) < 20:
                continue
            con.execute(
                "INSERT INTO entries(agent, project, session_id, ts, role, text, path, line) VALUES(?,?,?,?,?,?,?,?)",
                ("claude-mem", project, f"cm:{sid}", created or "", "observation", clip(redact(body), NOTE_CAP), src, n),
            )
            n += 1
        try:
            for sid, project, request, investigated, learned, completed, nxt, created in s.execute(
                "SELECT memory_session_id, project, request, investigated, learned, completed, next_steps, created_at FROM session_summaries"
            ):
                body = "\n".join(f"{k}: {v}" for k, v in (("요청", request), ("조사", investigated), ("배운 것", learned),
                                                          ("완료", completed), ("다음", nxt)) if v)
                if len(body) < 20:
                    continue
                con.execute(
                    "INSERT INTO entries(agent, project, session_id, ts, role, text, path, line) VALUES(?,?,?,?,?,?,?,?)",
                    ("claude-mem", project, f"cm:{sid}", created or "", "summary", clip(redact(body), NOTE_CAP), src, n),
                )
                n += 1
        except sqlite3.OperationalError:
            pass
    print(f"claude-mem 이관 {n}건 (출처 agent='claude-mem')")


def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return None


def cmd_doctor(args):
    src = discover_sources(load_config())
    by = {}
    for a, _ in src:
        by[a] = by.get(a, 0) + 1
    print(f"timecapsule {VERSION} · home {TC_HOME}")
    print("sources: " + (", ".join(f"{k} {v}" for k, v in by.items()) if by else "없음"))
    try:
        con = connect()
        print(f"db ok · schema {schema_version(con)} · tokenizer {tokenizer(con)} · sqlite {sqlite3.sqlite_version}"
              f" · python {sys.version.split()[0]}")
        n = con.execute("SELECT COUNT(*) FROM entries").fetchone()[0]
        f = con.execute("SELECT COUNT(*) FROM files").fetchone()[0]
        print(f"entries {n} · files {f}")
    except Exception as e:
        print(f"db 오류: {e}")
    settings = read_json(CLAUDE_SETTINGS) or {}
    for ev in ("SessionStart", "UserPromptSubmit", "Stop"):
        cmds = [h.get("command", "") for g in (settings.get("hooks") or {}).get(ev) or [] for h in g.get("hooks") or []]
        mine = [c for c in cmds if "timecapsule" in c]
        print(f"Claude Code 훅 {ev}: " + (mine[0] if mine else "없음"))
    desk = read_json(DESKTOP_CONFIG)
    if desk is None:
        print("Claude 데스크톱 MCP: 설정 파일 없음")
    else:
        srv = (desk.get("mcpServers") or {}).get("timecapsule")
        print("Claude 데스크톱 MCP: " + (" ".join([srv.get("command", "")] + list(srv.get("args") or [])) if srv else "없음"))
    baks = sorted(glob.glob(DB_PATH + ".bak-*"))
    if baks:
        print(f"backups: {len(baks)}개 · {sum(os.path.getsize(b) for b in baks) // 1024 // 1024} MB")


# ---------------------------------------------------------------- 훅
def read_hook_input():
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return {}
        r, _, _ = select.select([sys.stdin], [], [], 1.0)
        if not r:
            return {}
        data = sys.stdin.read()
        o = json.loads(data) if data.strip() else {}
        return o if isinstance(o, dict) else {}
    except Exception:
        return {}


def codex_hook_kind(data):
    """Codex 훅: 사람이 연 대화형 세션인가. 기록 첫 줄의 session_meta 로, 파일이 아직 없으면 조상 프로세스로 판정."""
    tp = data.get("transcript_path")
    if tp and os.path.exists(tp):
        try:
            with open(tp, "rb") as fh:
                o = json.loads(fh.readline() or b"{}")
            if o.get("type") == "session_meta":
                meta = o.get("payload") or {}
                return ("auto" if codex_origin(meta) in AUTO_ORIGINS else "interactive"), meta.get("id")
        except Exception as e:
            debug(f"codex transcript: {e}")
    return ("auto" if ancestor_is_codex_exec() else "interactive"), None


CODEX_VALUE_OPTS = {"-c", "--config", "-p", "--profile", "-m", "--model", "-C", "--cd", "-s", "--sandbox",
                    "-a", "--ask-for-approval", "-i", "--image", "--enable", "--disable"}


def codex_argv_is_exec(toks):
    """codex 뒤 인자 → 하위 명령이 exec 인가. 값을 받는 옵션(-c model=x 등)은 값까지 건너뛴다."""
    i = 0
    while i < len(toks):
        t = toks[i]
        if t in CODEX_VALUE_OPTS:
            i += 2
        elif t.startswith("-"):
            i += 1
        else:
            return t in ("exec", "e")
    return False


def is_codex_bin(tok):
    b = os.path.basename(tok)
    return b in ("codex", "codex.js") or b.startswith(("codex-aarch64", "codex-x86_64"))


def nearest_codex_is_exec(chain):
    """조상 명령줄(가까운 순)에서 가장 가까운 codex 프로세스 하나로 판정한다.

    실행 파일(argv[0], node 로 띄웠으면 argv[1])이 codex 인 프로세스만 본다 — 셸의 `-c '… codex exec …'` 같은
    명령 문자열 속 단어에 속지 않게.
    """
    for argv in chain:
        toks = argv.split()
        if not toks:
            continue
        i = 1 if os.path.basename(toks[0]) in ("node", "bun", "deno") and len(toks) > 1 else 0
        if is_codex_bin(toks[i]):
            return codex_argv_is_exec(toks[i + 1:])
    return False


def ancestor_chain(depth=12):
    import subprocess
    pid = os.getppid()
    for _ in range(depth):
        if pid <= 1:
            return
        try:
            out = subprocess.run(["ps", "-o", "ppid=,args=", "-p", str(pid)], capture_output=True, text=True, timeout=2).stdout
        except Exception:
            return
        if not out.strip():
            return
        ppid, _, argv = out.strip().partition(" ")
        yield argv
        try:
            pid = int(ppid)
        except ValueError:
            return


def ancestor_is_codex_exec():
    return nearest_codex_is_exec(ancestor_chain())


def cmd_hook(args):
    data = read_hook_input()
    if args.event.startswith("codex-"):
        kind, sid = codex_hook_kind(data)
        if kind != "interactive":  # exec·서브에이전트는 주입도 색인도 하지 않는다
            return
        if sid and not data.get("session_id"):
            data["session_id"] = sid
        args.event = args.event[len("codex-"):]
    if args.event == "stop":
        with alarm(10):
            run_index(connect(timeout=3), Budget(8))
        return
    if args.event == "prompt":  # 색인은 하지 않는다(Stop 훅이 턴마다 한다) — 조회만 짧게, 실패하면 조용히 비운다
        text = ""
        try:
            with alarm(env_int("TIMECAPSULE_PROMPT_TIMEOUT", 4)):
                text = prompt_context(
                    connect(timeout=1.0), data.get("prompt") or "",
                    data.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd(),
                    exclude_sid=data.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID"),
                    days=env_int("TIMECAPSULE_PROMPT_DAYS", PROMPT_DAYS), max_sessions=env_int("TIMECAPSULE_PROMPT_SESSIONS", PROMPT_SESSIONS),
                    max_chars=env_int("TIMECAPSULE_PROMPT_CHARS", PROMPT_CHARS))
        except (Exception, HardTimeout) as e:
            debug(f"prompt hook: {e.__class__.__name__}: {e}")
        if text:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": text}}, ensure_ascii=False))
        return
    try:  # 색인이 늦거나 막혀도 주입은 한다
        with alarm(6):
            run_index(connect(timeout=3), Budget(3))
    except (Exception, HardTimeout) as e:
        debug(f"session-start index: {e.__class__.__name__}: {e}")
    ns = argparse.Namespace(
        project=data.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd(), all=False,
        limit=env_int("TIMECAPSULE_RECENT_LIMIT", 5), days=None, max_chars=env_int("TIMECAPSULE_RECENT_CHARS", 3000),
        json=False, no_index=True, include_auto=False, include_current=False, exclude_session=data.get("session_id"))
    cmd_recent(ns)


